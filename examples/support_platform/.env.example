# 이 파일을 복사해 .env 로 저장하고 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 있어 커밋되지 않습니다. 키를 코드/커밋에 넣지 마세요.

# 모델 키 — 둘 중 하나만 설정하면 됩니다 (config/model.yaml 의 provider type 에 맞춰).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# 선택: 실행 환경 계층 — config/environments/<값>.yaml 을 덧씌운다.
# 미설정이면 메모리 체크포인터, postgres 면 DB 에 대화 이력이 남는다.
# KLAFI_ENV=postgres

# 선택: KLAFI_ENV=postgres 일 때 DSN (평문 config 금지 — 여기서 주입, SEC-05)
# KLAFI_PG_DSN=postgresql://user:pass@localhost:5433/klafi

# 선택: MCP Tavily 웹검색 (config/mcp.yaml 이 ${TAVILY_API_KEY} 로 주입). `pip install 'klafi[mcp]'` + npx 필요.
# TAVILY_API_KEY=tvly-...

# 선택: Intelligence 서비스에서 OTLP 설정을 받아 trace 송출 (`pip install 'klafi[otlp]'` 필요).
# ON 이면 {ENDPOINT}{CONFIG_PATH} 를 GET 해 {"endpoint","headers"} 를 받는다. 실패/OFF 면
# config/observability.yaml 의 otlp 로 폴백, 그것도 없으면 계측만(송출 없음). 부팅은 절대 안 막는다.
# INTELLIGENCE_MODE=ON
# INTELLIGENCE_ENDPOINT=https://intelligence.internal
# INTELLIGENCE_TOKEN=            # 선택: Authorization Bearer
# INTELLIGENCE_CONFIG_PATH=/v1/observability/otlp   # 사내 스펙에 맞게 재정의
# INTELLIGENCE_TIMEOUT=3
